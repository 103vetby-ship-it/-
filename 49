<script>
window.addEventListener('load', () => { setTimeout(() => { document.getElementById('preloader').classList.add('hidden'); setTimeout(() => { document.getElementById('preloader').style.display = 'none'; }, 800); }, 500); });
const cursor = document.getElementById('cursor');
const hoverElements = document.querySelectorAll('[data-hover]');
if (window.matchMedia("(hover: hover)").matches) {
document.addEventListener('mousemove', (e) => { cursor.style.left = e.clientX + 'px'; cursor.style.top = e.clientY + 'px'; }, { passive: true });
hoverElements.forEach(el => { el.addEventListener('mouseenter', () => cursor.classList.add('hovered')); el.addEventListener('mouseleave', () => cursor.classList.remove('hovered')); });
}
const scrollProgress = document.getElementById('scrollProgress');
window.addEventListener('scroll', () => { const winScroll = document.body.scrollTop || document.documentElement.scrollTop; const height = document.documentElement.scrollHeight - document.documentElement.clientHeight; scrollProgress.style.width = (winScroll / height) * 100 + '%'; }, { passive: true });
const floatingCtaEl = document.getElementById('floatingCta');
if (floatingCtaEl) { window.addEventListener('scroll', () => { if (window.scrollY > 600) { floatingCtaEl.classList.add('visible'); } else { floatingCtaEl.classList.remove('visible'); } }, { passive: true }); }
const stamp = document.getElementById('stamp');
if (stamp) setInterval(() => stamp.classList.toggle('morphed'), 4000);
const particlesContainer = document.getElementById('particles');
if (particlesContainer) { for (let i = 0; i < 20; i++) { const particle = document.createElement('div'); particle.className = 'particle'; particle.style.left = Math.random() * 100 + '%'; particle.style.top = Math.random() * 100 + '%'; particle.style.animationDelay = Math.random() * 8 + 's'; particle.style.animationDuration = (6 + Math.random() * 4) + 's'; particlesContainer.appendChild(particle); } }
const heroDiamondContainer = document.getElementById('heroDiamondContainer');
let heroDiamondLoaded = false;
const loadHeroDiamond = () => { if (heroDiamondLoaded) return; heroDiamondLoaded = true; const script = document.createElement('script'); script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js'; script.onload = initHeroDiamond; document.head.appendChild(script); };
if (heroDiamondContainer) { const heroDiamondObserver = new IntersectionObserver((entries) => { entries.forEach(entry => { if (entry.isIntersecting) { loadHeroDiamond(); heroDiamondObserver.unobserve(entry.target); } }); }, { threshold: 0.2 }); heroDiamondObserver.observe(heroDiamondContainer); }
function initHeroDiamond() {
const container = document.getElementById('heroDiamondContainer');
const canvas = document.getElementById('hero-diamond-canvas');
if (!container || !canvas) return;
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
camera.position.z = 7;
const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.8;
scene.add(new THREE.AmbientLight(0xffffff, 0.5));
const goldLight = new THREE.PointLight(0xD4AF37, 3, 25); goldLight.position.set(5, 5, 6); scene.add(goldLight);
const emeraldLight = new THREE.PointLight(0x2D6A4F, 2.5, 25); emeraldLight.position.set(-5, -3, 5); scene.add(emeraldLight);
const whiteLight = new THREE.PointLight(0xFFFFFF, 2.5, 25); whiteLight.position.set(0, 6, 4); scene.add(whiteLight);
const numFacets = 8, radius = 1.2, crownHeight = 0.4, pavilionDepth = 1.1, tableRadius = 0.7;
const vertices = [], indices = [];
vertices.push(0, -pavilionDepth, 0);
const girdleIndices = [], crownIndices = [], tableIndices = [];
for (let i = 0; i < numFacets; i++) { const angle = (i / numFacets) * Math.PI * 2; vertices.push(Math.cos(angle) * radius, 0, Math.sin(angle) * radius); girdleIndices.push(i + 1); }
for (let i = 0; i < numFacets; i++) { const angle = (i / numFacets) * Math.PI * 2 + (Math.PI / numFacets); vertices.push(Math.cos(angle) * (radius * 0.85), crownHeight * 0.5, Math.sin(angle) * (radius * 0.85)); crownIndices.push(i + 1 + numFacets); }
for (let i = 0; i < numFacets; i++) { const angle = (i / numFacets) * Math.PI * 2; vertices.push(Math.cos(angle) * tableRadius, crownHeight, Math.sin(angle) * tableRadius); tableIndices.push(i + 1 + numFacets * 2); }
for (let i = 0; i < numFacets; i++) { const next = (i + 1) % numFacets; indices.push(0, girdleIndices[i], girdleIndices[next]); indices.push(girdleIndices[i], crownIndices[i], girdleIndices[next]); indices.push(girdleIndices[next], crownIndices[i], crownIndices[next]); indices.push(crownIndices[i], tableIndices[i], crownIndices[next]); indices.push(crownIndices[next], tableIndices[i], tableIndices[next]); }
const centerIndex = 17 + numFacets;
vertices.push(0, crownHeight, 0);
for (let i = 0; i < numFacets; i++) indices.push(centerIndex, tableIndices[i], tableIndices[(i + 1) % numFacets]);
const geometry = new THREE.BufferGeometry();
geometry.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
geometry.setIndex(indices);
geometry.computeVertexNormals();
const edges = new THREE.LineSegments(new THREE.EdgesGeometry(geometry, 15), new THREE.LineBasicMaterial({ color: 0xD4AF37, transparent: true, opacity: 0.6 }));
edges.scale.set(1.6, 1.6, 1.6);
scene.add(edges);
const pawGroup = new THREE.Group();
const goldMaterial = new THREE.MeshStandardMaterial({ color: 0xD4AF37, emissive: 0xD4AF37, emissiveIntensity: 0.4, metalness: 0.8, roughness: 0.2 });
const mainPad = new THREE.Mesh(new THREE.SphereGeometry(0.28, 16, 16), goldMaterial);
mainPad.scale.set(1, 1, 1);
mainPad.position.set(0, -0.1, 0);
pawGroup.add(mainPad);
const toeGeometry = new THREE.SphereGeometry(0.13, 16, 16);
const toes = [{ x: -0.22, y: 0.22, sx: 0.9, sy: 1.1 }, { x: -0.08, y: 0.28, sx: 0.9, sy: 1.15 }, { x: 0.08, y: 0.28, sx: 0.9, sy: 1.15 }, { x: 0.22, y: 0.22, sx: 0.9, sy: 1.1 }];
toes.forEach(t => { const toe = new THREE.Mesh(toeGeometry, goldMaterial); toe.position.set(t.x, t.y, 0); toe.scale.set(t.sx, t.sy, 0.9); pawGroup.add(toe); });
pawGroup.position.set(0, 0.1, 0);
pawGroup.scale.set(0.8, 0.8, 0.8);
const textCanvas = document.createElement('canvas');
textCanvas.width = 512; textCanvas.height = 192;
const ctx = textCanvas.getContext('2d');
ctx.clearRect(0, 0, textCanvas.width, textCanvas.height);
ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = '#D4AF37'; ctx.font = 'bold 52px "Inter", "Arial", sans-serif';
ctx.fillText('ВАКЦИНАЦИЯ', textCanvas.width / 2, textCanvas.height / 2 - 32);
ctx.fillText('НА ДОМУ', textCanvas.width / 2, textCanvas.height / 2 + 32);
const textTexture = new THREE.CanvasTexture(textCanvas);
textTexture.needsUpdate = true;
const textSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: textTexture, transparent: true, depthTest: false, opacity: 0.95 }));
textSprite.scale.set(2.5, 0.94, 1);
textSprite.position.set(0, -0.85, 0);
pawGroup.add(textSprite);
scene.add(pawGroup);
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(80 * 3);
for(let i = 0; i < 80 * 3; i++) { pPos[i] = (Math.random() - 0.5) * 12; }
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
const pMesh = new THREE.Points(pGeo, new THREE.PointsMaterial({ size: 0.04, color: 0xF5DEB3, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending }));
scene.add(pMesh);
const clock = new THREE.Clock();
const animate = () => {
requestAnimationFrame(animate);
const t = clock.getElapsedTime();
edges.rotation.y += 0.005;
edges.position.y = Math.sin(t * 1.2) * 0.15;
pawGroup.rotation.y = edges.rotation.y;
pawGroup.position.y = Math.sin(t * 1.2) * 0.15;
pMesh.rotation.y = t * 0.08;
pMesh.position.y = Math.sin(t * 0.5) * 0.2;
renderer.render(scene, camera);
};
animate();
window.addEventListener('resize', () => { camera.aspect = container.clientWidth / container.clientHeight; camera.updateProjectionMatrix(); renderer.setSize(container.clientWidth, container.clientHeight); });
}
</script>
